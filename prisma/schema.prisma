  // (amountPaise); this Payment table has no app writer yet. If wired up, keep this
  // as rupees or rename to amountPaise to match the rest of the payment path.
  amountInr         Int       @map("amount_inr")
  membershipId      String?   @map("membership_id") @db.Uuid
  razorpayOrderId   String?   @map("razorpay_order_id") @db.VarChar(64)
  razorpayPaymentId String?   @map("razorpay_payment_id") @db.VarChar(64)
  status            PaymentStatus @default(created)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  paidAt            DateTime? @map("paid_at") @db.Timestamptz

  user       User        @relation(fields: [userId], references: [id])
  membership Membership? @relation(fields: [membershipId], references: [id])
