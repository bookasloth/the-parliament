// MODULES: Events
// ─────────────────────────────────────────────

model Event {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  hostId          String    @map("host_id") @db.Uuid
  groupId         String?   @map("group_id") @db.Uuid
  title           String    @db.VarChar(200)
  description     String?
  bannerUrl       String?   @map("banner_url")
  startsAt        DateTime  @map("starts_at") @db.Timestamptz
  endsAt          DateTime? @map("ends_at") @db.Timestamptz
  mode            String    @db.VarChar(20)
  venue           String?   @db.VarChar(240)
  onlineUrl       String?   @map("online_url")
  hostHouseId     String?   @map("host_house_id") @db.Uuid
  isHouseSpecific Boolean   @default(false) @map("is_house_specific")
  isFeatured      Boolean   @default(false) @map("is_featured")
  priceInPaise    Int       @default(0) @map("price_paise") // 0 = free
  visibility      EventVisibility @default(school)
  status          EventStatus @default(published)
  reminderSentAt  DateTime? @map("reminder_sent_at") @db.Timestamptz // T-24h RSVP reminder fan-out marker
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  school     School            @relation(fields: [schoolId], references: [id])
  host        User             @relation("event_host", fields: [hostId], references: [id])
  inviteWaves EventInviteWave[]
  group      Group?            @relation(fields: [groupId], references: [id])
  hostHouse  House?            @relation(fields: [hostHouseId], references: [id])
  rsvps      EventRsvp[]
  attendance EventAttendance[]
  feedback   EventFeedback[]
  orders     EventOrder[]

  @@index([schoolId, startsAt])
  @@index([hostHouseId])
  @@map("events")
}

// Staggered "Invite All" waves for an event. The admin creates 4 rows (one per
// membership tier) with escalating sendAfter times; a cron sends the due ones.
model EventInviteWave {
  id        String    @id @default(uuid()) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  tier      String    @db.VarChar(20)
  sendAfter DateTime  @map("send_after") @db.Timestamptz
  status    String    @default("pending") @db.VarChar(20)
  sentCount Int       @default(0) @map("sent_count")
  sentAt    DateTime? @map("sent_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, tier])
  @@index([status, sendAfter])
  @@map("event_invite_waves")
}

model EventRsvp {
  eventId String   @map("event_id") @db.Uuid
  userId  String   @map("user_id") @db.Uuid
