// Frozen period champions. One row per winner per (scope, period, anchor); ties
// share rank 1 as co-champions (multiple rows, same anchor). Powers the Hall of
// Champions + profile trophy case (derived: rows whose winnerKey matches the
// user's id / houseId / batchId). winnerLabel is denormalized to survive deletion.
model GameChampion {
  gameId      String   @map("game_id") @db.Uuid
  scope       String   @db.VarChar(12) // individual | house | batch
  period      String   @db.VarChar(12) // daily | weekly | monthly | yearly
  anchor      String   @db.VarChar(16) // 2026-08-05 | 2026-W23 | 2026-08 | 2026
  winnerKey   String   @map("winner_key") @db.Uuid // userId | houseId | batchId
  winnerLabel String   @map("winner_label") @db.VarChar(120)
  totalScore  Int      @map("total_score")
  decidedAt   DateTime @default(now()) @map("decided_at") @db.Timestamptz

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, scope, period, anchor, winnerKey])
  @@index([scope, period])
  @@index([winnerKey])
  @@map("game_champions")
}

// ─────────────────────────────────────────────
// MODULES: Analytics / Action Log
// ─────────────────────────────────────────────

model ActivityEvent {
  id         BigInt   @id @default(autoincrement())
  userId     String?  @map("user_id") @db.Uuid
  eventType  String   @map("event_type") @db.VarChar(60)
  entityType String?  @map("entity_type") @db.VarChar(30)
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json     @default("{}")
  ipInet     String?  @map("ip_inet")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@map("activity_events")
}

// ─────────────────────────────────────────────
// Cross-cutting: Rate Limiting + Audit Log
// ─────────────────────────────────────────────

model RateLimitCounter {
  bucket    String   @db.VarChar(120)
  windowKey String   @map("window_key") @db.VarChar(40)
  count     Int      @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@id([bucket, windowKey])
  @@index([expiresAt])
  @@map("rate_limit_counters")
}

// Idempotency ledger for incoming payment-provider webhooks. Razorpay retries a
// delivery on any non-2xx and can re-send the same event; the unique eventId
// (X-Razorpay-Event-Id) lets the handler skip an event it has already applied.
model ProcessedWebhookEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @unique @map("event_id") @db.VarChar(128)
  eventType String   @map("event_type") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("processed_webhook_events")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(60)
  entityType String?  @map("entity_type") @db.VarChar(30)
  entityId   String?  @map("entity_id") @db.Uuid
  payload    Json     @default("{}")
  ipInet     String?  @map("ip_inet")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// Email infrastructure (MEMBERSHIP_PLAN.md §12)
// ─────────────────────────────────────────────

model EmailTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(80)
  subject   String   @db.VarChar(240)
  htmlBody  String   @map("html_body")
  textBody  String   @map("text_body")
  category  String   @db.VarChar(30)
  variables Json     @default("{}")
  isActive  Boolean  @default(true) @map("is_active")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([category, isActive])
  @@map("email_templates")
}

model EmailMessage {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  toAddress     String    @map("to_address") @db.VarChar(254)
  templateCode  String    @map("template_code") @db.VarChar(80)
  category      String    @db.VarChar(30)
  subject       String    @db.VarChar(240)
  status        EmailStatus @default(queued)
  queuedAt      DateTime  @default(now()) @map("queued_at") @db.Timestamptz
  sentAt        DateTime? @map("sent_at") @db.Timestamptz
  error         String?
  providerMsgId String?   @map("provider_msg_id") @db.VarChar(160)
  metadata      Json      @default("{}")

  @@index([userId, queuedAt])
  @@index([templateCode])
  @@index([category])
  @@index([providerMsgId])
  @@index([status, queuedAt])
  @@map("email_messages")
}

model EmailPreference {
  userId             String  @id @map("user_id") @db.Uuid
  transactional      Boolean @default(true)
  lifecycle          Boolean @default(true)
  reminders          Boolean @default(true)
  wishes             Boolean @default(true)
  festivalGreetings  Boolean @default(true) @map("festival_greetings")
  engagement         Boolean @default(true)
  digests            Boolean @default(true)
  marketing          Boolean @default(true)
  quietHoursStartIst Int?    @map("quiet_hours_start_ist")
  quietHoursEndIst   Int?    @map("quiet_hours_end_ist")
  language           String  @default("en") @db.VarChar(8)

  @@map("email_preferences")
}

model EmailSuppression {
  emailAddress String   @id @map("email_address") @db.VarChar(254)
  reason       String   @db.VarChar(30)
  suppressedAt DateTime @default(now()) @map("suppressed_at") @db.Timestamptz

  @@map("email_suppressions")
}

model EmailUnsubscribeToken {
  token     String   @id @db.VarChar(80)
  userId    String   @map("user_id") @db.Uuid
  category  String   @db.VarChar(30)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, category])
  @@index([expiresAt])
  @@map("email_unsubscribe_tokens")
}

