  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("event_feedback")
}

// Paid-event registration order. Mirrors MembershipOrder: a one-time Razorpay
// order; on capture (verify path) it flips to "paid" and a going RSVP is
// upserted = the registration. Free events never create one.
model EventOrder {
  id                String    @id @default(uuid()) @db.Uuid
  eventId           String    @map("event_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  amountPaise       Int       @map("amount_paise")
  currency          String    @default("INR") @db.VarChar(3)
  status            String    @default("created") @db.VarChar(20) // created|attempted|paid|failed
  razorpayOrderId   String?   @unique @map("razorpay_order_id") @db.VarChar(64)
  razorpayPaymentId String?   @map("razorpay_payment_id") @db.VarChar(64)
  razorpaySignature String?   @map("razorpay_signature")
  capturedAt        DateTime? @map("captured_at") @db.Timestamptz
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, status])
  @@index([userId, createdAt])
  @@map("event_orders")
}

