generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// 0. School & Org Structure
// ─────────────────────────────────────────────

model School {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  slug      String   @unique @db.VarChar(80)
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  houses             House[]
  divisions          Division[]
  batches            Batch[]
  users              User[]
  groups             Group[]
  events             Event[]
  games              Game[]
  tournaments        Tournament[]
  rewardItems        RewardItem[]
  badges             Badge[]
  businessCategories BusinessCategory[]
  postCategories     PostCategory[]
  spotlights         Spotlight[]
  posts              Post[]
  businesses         Business[]
  karmaThresholds    KarmaThreshold[]

  @@map("schools")
}

model House {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  name        String   @db.VarChar(80)
  colorName   String   @map("color_name") @db.VarChar(30)
  colorHex    String   @map("color_hex") @db.Char(7)
  slogan      String?  @db.VarChar(200)
  isGirlsOnly Boolean  @default(false) @map("is_girls_only")
  // House system: "pre2002" (old boys/girls houses) or "ansu" (post-2002,
  // everyone). Distinct identities even when they share a colour.
  system      String   @default("ansu") @db.VarChar(20)
  // null = open to any gender (ANSU); "male"/"female" = restricted (pre-2002).
  gender      String?  @db.VarChar(10)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  profiles Profile[]
  events   Event[]
  groups   Group[]
  postMentions PostMention[]

  @@unique([schoolId, name])
  @@map("houses")
}

model Division {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String   @db.VarChar(80)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userDivisions UserDivision[]

  @@unique([schoolId, name])
  @@map("divisions")
}

model Batch {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  startYear Int      @map("start_year")
  endYear   Int      @map("end_year")
  label     String   @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  profiles Profile[]
  groups   Group[]
  postMentions PostMention[]

  @@unique([schoolId, startYear])
  @@map("batches")
}

// ─────────────────────────────────────────────
// 1. Identity & Authentication
// ─────────────────────────────────────────────

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  schoolId             String?   @map("school_id") @db.Uuid
  email                String    @db.VarChar()
  emailVerifiedAt      DateTime? @map("email_verified_at") @db.Timestamptz
  username             String?   @unique @db.VarChar(60)
  mobileE164           String?   @map("mobile_e164") @db.VarChar(20)
  mobileVerifiedAt     DateTime? @map("mobile_verified_at") @db.Timestamptz
  passwordHash         String?   @map("password_hash")
  legalName            String    @map("legal_name") @db.VarChar(160)
  displayName          String    @default("") @map("display_name") @db.VarChar(120)
  memberType           String    @default("alumni") @map("member_type") @db.VarChar(20)
  dateOfBirth          DateTime? @map("date_of_birth") @db.Date
  gender               String?   @db.VarChar(20)
  currentClass         Int?      @map("current_class")
  yearsStudied         Int?      @map("years_studied")
  currentStatus        String?   @map("current_status") @db.VarChar(20)
  isVerified           Boolean   @default(false) @map("is_verified")
  verifiedAt           DateTime? @map("verified_at") @db.Timestamptz
  status               UserStatus @default(active)
  lastLoginAt          DateTime? @map("last_login_at") @db.Timestamptz
  onboardingStep       String    @default("profile") @map("onboarding_step") @db.VarChar(30)
  onboardingCompleted  Boolean   @default(false) @map("onboarding_completed")
  profileCompletion    Int       @default(0) @map("profile_completion")
  verificationStatus   VerificationStatus @default(pending) @map("verification_status")
  membershipStatus     String    @default("student") @map("membership_status") @db.VarChar(20)
  membershipExpiresAt  DateTime? @map("membership_expires_at") @db.Timestamptz
  membershipCycleStart DateTime? @map("membership_cycle_start") @db.Timestamptz
  benefitTier          String    @default("base") @map("benefit_tier") @db.VarChar(20)
  passOutYear          Int?      @map("pass_out_year")
  isSuperAdmin         Boolean   @default(false) @map("is_super_admin")
  verificationData     Json?     @map("verification_data")
  membershipData       Json?     @map("membership_data")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz

  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  profile                  Profile?
  credentials              UserCredential[]
  sessions                 UserSession[]
  mfaFactors               MfaFactor[]
  verificationTokens       VerificationToken[]
  alumniVerifications      AlumniVerification[]
  userRoles                UserRole[]
  userDivisions            UserDivision[]
  reactions                Reaction[]
  postMentions             PostMention[]
  contentReports           ContentReport[]
  conversations            ConversationParticipant[]
  eventsHosted             Event[]                   @relation("event_host")
  guardianConsents         GuardianConsent[]
  userKarma                UserKarma?
  karmaTransactions        KarmaTransaction[]
  karmaDailyCounters       KarmaDailyCounter[]
  karmaPairActor           KarmaPairDay[]            @relation("karma_actor")
  karmaPairTarget          KarmaPairDay[]            @relation("karma_target")
  following                Follow[]                  @relation("following")
  followers                Follow[]                  @relation("followers")
  blocksGiven              UserBlock[]               @relation("blocker")
  blocksReceived           UserBlock[]               @relation("blocked")
  posts                    Post[]
  comments                 Comment[]
  postShares               PostShare[]
  eventRsvps               EventRsvp[]
  eventAttendance          EventAttendance[]
  eventFeedback            EventFeedback[]
  eventOrders              EventOrder[]
  businesses               Business[]
  businessReviews          BusinessReview[]
  memberships              Membership[]
  payments                 Payment[]
  donations                Donation[]
  groupMembers             GroupMember[]
  gameScores               GameScore[]
  matchParticipants        MatchParticipant[]
  tournamentEntries        TournamentEntry[]
  membershipOrders         MembershipOrder[]
  membershipInvoices       MembershipInvoice[]
  membershipRefunds        MembershipRefund[]        @relation("refund_initiator")
  membershipEvents         MembershipEvent[]         @relation("event_subject")
  membershipEventsActed    MembershipEvent[]         @relation("event_actor")
  committeeInvitesReceived CommitteeInvite[]         @relation("committee_invitee")
  committeeInvitesSent     CommitteeInvite[]         @relation("committee_inviter")
  pollEligibilities        PollEligibility[]
  activityEvents           ActivityEvent[]
  userBadges               UserBadge[]
  karmaRedemptions         KarmaRedemption[]
  groupRequests            GroupRequest[]
  sentMessages             Message[]                 @relation("message_sender")
  messageReactions         MessageReaction[]
  savedPosts               SavedPost[]
  hiddenPosts              HiddenPost[]
  postImpressions          PostImpression[]
  postAwards               PostAward[]
  pollVotes                PollVote[]
  notifications            Notification[]
  interests                UserInterest[]
  onboardingProgress       OnboardingProgress[]
  experiences              Experience[]
  educations               Education[]

  @@unique([email])
  @@index([status])
  @@index([schoolId])
  @@index([memberType])
  @@map("users")
}

model UserCredential {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  provider     String    @db.VarChar(40)
  providerUid  String    @map("provider_uid") @db.VarChar(255)
  accessToken  String?   @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@map("user_credentials")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?
  ipInet           String?   @map("ip_inet")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  rotatedFrom      String?   @map("rotated_from") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedRef UserSession?  @relation("SessionRotation", fields: [rotatedFrom], references: [id])
  rotations  UserSession[] @relation("SessionRotation")

  @@unique([refreshTokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ─────────────────────────────────────────────
// 1b. Interests & Onboarding
// ─────────────────────────────────────────────

model Interest {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(80)
  slug      String   @unique @db.VarChar(80)
  icon      String?  @db.VarChar(40)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  users UserInterest[]

  @@index([slug])
  @@map("interests")
}

model UserInterest {
  userId     String   @map("user_id") @db.Uuid
  interestId String   @map("interest_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@map("user_interests")
}

model OnboardingProgress {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  step      String   @default("profile") @db.VarChar(30)
  data      Json     @default("{}")
  completed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

model MfaFactor {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String    @db.VarChar(20)
  secretEnc   String?   @map("secret_enc")
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_factors")
}

model VerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  purpose    String    @db.VarChar(30)
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// 2. Profile
// ─────────────────────────────────────────────

model Experience {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  title          String    @db.VarChar(160)
  company        String    @db.VarChar(160)
  employmentType String?   @map("employment_type") @db.VarChar(30)
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  location       String?   @db.VarChar(160)
  locationType   String?   @map("location_type") @db.VarChar(20)
  description    String?
  skills         Json      @default("[]")
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@map("experiences")
}

model Education {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  school       String    @db.VarChar(200)
  degree       String?   @db.VarChar(160)
  fieldOfStudy String?   @map("field_of_study") @db.VarChar(160)
  startYear    Int?      @map("start_year")
  endYear      Int?      @map("end_year")
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endYear])
  @@map("educations")
}

model Profile {
  userId               String   @id @map("user_id") @db.Uuid
  photoUrl             String?  @map("photo_url")
  coverUrl             String?  @map("cover_url")
  bio                  String?
  houseId              String?  @map("house_id") @db.Uuid
  batchId              String?  @map("batch_id") @db.Uuid
  department           String?  @db.VarChar(120)
  city                 String?  @db.VarChar(120)
  homeTown             String?  @map("home_town") @db.VarChar(160)
  correspondenceAddress String? @map("correspondence_address")
  bloodGroup           String?  @map("blood_group") @db.VarChar(5)
  bloodDonor           Boolean  @default(false) @map("blood_donor")
  profession           String?  @db.VarChar(160)
  company              String?  @db.VarChar(160)
  industry             String?  @db.VarChar(120)
  designation          String?  @db.VarChar(160)
  workSince            DateTime? @map("work_since") @db.Date
  higherEducation      String?  @map("higher_education") @db.VarChar(200)
  skills               Json     @default("[]")
  linkedinUrl          String?  @map("linkedin_url")
  headline             String?  @db.VarChar(200)
  socialLinks          Json     @default("{}") @map("social_links")
  whatsappOptIn        Boolean  @default(false) @map("whatsapp_opt_in")
  visibility           ProfileVisibility @default(alumni)
  isPublicIndexed      Boolean  @default(false) @map("is_public_indexed")
  showOnMap            Boolean  @default(false) @map("show_on_map")
  isComplete           Boolean  @default(false) @map("is_complete")
  contactAlwaysShare   Boolean  @default(false) @map("contact_always_share")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  house House? @relation(fields: [houseId], references: [id])
  batch Batch? @relation(fields: [batchId], references: [id])

  @@index([batchId])
  @@index([city])
  @@index([company])
  @@map("profiles")
}

model UserDivision {
  userId      String   @map("user_id") @db.Uuid
  divisionId  String   @map("division_id") @db.Uuid
  isProtected Boolean  @default(false) @map("is_protected")
  addedAt     DateTime @default(now()) @map("added_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id])

  @@id([userId, divisionId])
  @@index([divisionId])
  @@map("user_divisions")
}

// ─────────────────────────────────────────────
// 3. Alumni Verification
// ─────────────────────────────────────────────

model AlumniVerification {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  method         String    @db.VarChar(30)
  evidenceUrl    String?   @map("evidence_url")
  instituteEmail String?   @map("institute_email") @db.VarChar()
  status         AlumniVerificationStatus @default(pending)
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz
  rejectReason   String?   @map("reject_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("alumni_verifications")
}

// Peer endorsements for a verification. An admin who can't personally vouch for a
// candidate asks batch/house-mates to confirm they studied together. Advisory
// signal only — the admin still makes the final approve call.
// Plain FK-less fields + app-layer joins (same convention as Reaction/ContentReport).
model Endorsement {
  id             String    @id @default(uuid()) @db.Uuid
  verificationId String    @map("verification_id") @db.Uuid
  candidateId    String    @map("candidate_id") @db.Uuid // user being verified
  endorserId     String    @map("endorser_id") @db.Uuid  // user asked to vouch
  requestedBy    String    @map("requested_by") @db.Uuid // admin who sent the ask
  status         String    @default("pending") @db.VarChar(16) // pending | endorsed | declined | expired
  token          String    @unique @db.VarChar(64)
  note           String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  respondedAt    DateTime? @map("responded_at") @db.Timestamptz
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz

  @@unique([verificationId, endorserId])
  @@index([verificationId])
  @@index([endorserId, status])
  @@map("endorsements")
}

// ─────────────────────────────────────────────
// 4. Authorization
// ─────────────────────────────────────────────

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      AdminRole
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

// ─────────────────────────────────────────────
// 5. Social Graph
// ─────────────────────────────────────────────

model Follow {
  id          String   @id @default(uuid()) @db.Uuid
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  follower  User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// "Who viewed your profile" — one row per (profile, viewer), bumped on each
// visit. Drives the weekly profile-views re-engagement email. FK columns are
// enforced in the migration (no Prisma relation, to keep the User model lean).
model ProfileView {
  profileUserId String   @map("profile_user_id") @db.Uuid
  viewerId      String   @map("viewer_id") @db.Uuid
  count         Int      @default(1)
  lastViewedAt  DateTime @default(now()) @map("last_viewed_at") @db.Timestamptz

  @@id([profileUserId, viewerId])
  @@index([profileUserId, lastViewedAt])
  @@map("profile_views")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

// ─────────────────────────────────────────────
// 6. Posts, Comments, Reactions, Reports
// ─────────────────────────────────────────────

model PostCategory {
  id        String  @id @default(uuid()) @db.Uuid
  schoolId  String? @map("school_id") @db.Uuid
  key       String  @db.VarChar(40)
  label     String  @db.VarChar(80)
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  school School? @relation(fields: [schoolId], references: [id])
  posts  Post[]

  @@unique([schoolId, key])
  @@map("post_categories")
}

model Post {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  authorId        String    @map("author_id") @db.Uuid
  groupId         String?   @map("group_id") @db.Uuid
  categoryId      String    @map("category_id") @db.Uuid
  format          String    @default("text") @db.VarChar(20)
  body            String?
  media           Json      @default("[]")
  linkUrl         String?   @map("link_url")
  visibilityScope String    @default("network") @map("visibility_scope") @db.VarChar(20)
  isPinned        Boolean   @default(false) @map("is_pinned")
  isEdited        Boolean   @default(false) @map("is_edited")
  editedAt        DateTime? @map("edited_at") @db.Timestamptz
  upvoteCount     Int       @default(0) @map("upvote_count")
  downvoteCount   Int       @default(0) @map("downvote_count")
  commentCount    Int       @default(0) @map("comment_count")
  shareCount      Int       @default(0) @map("share_count")
  qualityScore    Decimal   @default(0) @map("quality_score") @db.Decimal(8, 3)
  engagementScore Decimal   @default(0) @map("engagement_score") @db.Decimal(8, 3)
  reportPenalty   Decimal   @default(0) @map("report_penalty") @db.Decimal(8, 3)
  rankingScore    Decimal   @default(0) @map("ranking_score") @db.Decimal(10, 3)
  status          PostStatus @default(visible)
  quoteSource     String?   @map("quote_source")
  isAnonymous     Boolean   @default(false) @map("is_anonymous")
  textBg          String?   @map("text_bg") @db.VarChar(20)
  viewCount       Int       @default(0) @map("view_count")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  school   School?      @relation(fields: [schoolId], references: [id])
  author   User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category PostCategory @relation(fields: [categoryId], references: [id])
  group    Group?       @relation(fields: [groupId], references: [id])

  comments Comment[]
  shares   PostShare[]
  mentions PostMention[]
  savedBy  SavedPost[]
  hiddenBy HiddenPost[]
  impressions PostImpression[]
  awards   PostAward[]
  hashtags PostHashtag[]
  poll     Poll?

  @@index([authorId])
  @@index([createdAt])
  @@index([categoryId])
  @@index([schoolId, rankingScore])
  @@index([schoolId, engagementScore])
  @@index([schoolId, isPinned])
  @@index([groupId, createdAt])
  @@map("posts")
}

model PostMention {
  id          String  @id @default(uuid()) @db.Uuid
  postId      String  @map("post_id") @db.Uuid
  mentionType String  @map("mention_type") @db.VarChar(10)
  userId      String? @map("user_id") @db.Uuid
  houseId     String? @map("house_id") @db.Uuid
