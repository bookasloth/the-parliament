// Alfazy word dictionary. Daily puzzle = the row whose `idx` equals
// (daysSinceLaunch % activeCount), so the ordering is stable and deterministic.
// Seeded via SQL (see docs plan). idx is a dense 0-based sequence over active rows.
model AlfazyWord {
  id       String  @id @default(uuid()) @db.Uuid
  idx      Int     @unique
  word     String  @unique @db.VarChar(5)
  isActive Boolean @default(true) @map("is_active")

  @@index([isActive, idx])
  @@map("alfazy_words")
}

model GameScore {
  id           String   @id @default(uuid()) @db.Uuid
  gameId       String   @map("game_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  score        Int      @default(0)
  levelReached Int?     @map("level_reached") // Alfazy: guesses used (1-6); null = failed
  solved       Boolean  @default(false)
  puzzleDate   DateTime @map("puzzle_date") @db.Date
  karmaAwarded Decimal  @default(0) @map("karma_awarded") @db.Decimal(8, 2)
  playedAt     DateTime @default(now()) @map("played_at") @db.Timestamptz

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId, puzzleDate]) // one play per user per day — no farming
  @@index([gameId, score])
  @@index([userId, playedAt])
  @@index([gameId, puzzleDate])
  @@map("game_scores")
}

model GameMatch {
